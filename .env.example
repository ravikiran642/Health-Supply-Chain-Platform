# Environment
PROJECT_NAME="Health Supply Chain Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL 16)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=health_supply_chain
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_supply_chain

# Redis (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security & JWT Tokens
SECRET_KEY=replace-this-with-a-secure-32-byte-hex-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=20
